# ── Flask ────────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# ── Application ──────────────────────────────────────────────────────
# Secret key digunakan untuk signing session cookie Flask.
# Ganti dengan string acak yang panjang di production.
SECRET_KEY=change_me_in_production

# ── Langflow AI ───────────────────────────────────────────────────────
# URL Langflow. Default: http://localhost:7860 (local).
# Ganti jika Langflow berjalan di server/cloud lain.
LANGFLOW_BASE_URL=http://localhost:7860

# Flow ID: salin dari URL Langflow setelah /flow/ atau dari API endpoint.
# Contoh: a1b2c3d4-e5f6-7890-abcd-ef1234567890
LANGFLOW_FLOW_ID=your_flow_id_here

# API Key Langflow (opsional jika instance lokal tanpa auth).
# Bisa digenerate di Langflow → Settings → API Keys.
LANGFLOW_API_KEY=your_langflow_api_key_here

# ── IoT / External API ───────────────────────────────────────────────
# API key untuk autentikasi payload dari perangkat IoT
API_KEY=your_iot_api_key_here

# Mode demo/simulasi: aktifkan tombol simulasi di dashboard (tanpa ESP32)
# Atur ke "true" untuk demo, "false" (default) untuk production
DEMO_MODE=false

# ── Google Sheets ─────────────────────────────────────────────────────
# Path ke file JSON service account Google Cloud.
# Contoh: service-account.json  (letakkan di root project, JANGAN di-commit)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# ID spreadsheet Google Sheets (dari URL: /spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=your_spreadsheet_id_here

# ── Database (dikonfigurasi saat persistence ditambahkan) ────────────
# DATABASE_URL=sqlite:///pantaujantung.db

# ── Optional: MQTT broker ────────────────────────────────────────────
# MQTT_BROKER=localhost
# MQTT_PORT=1883
# MQTT_TOPIC=jantung/data
